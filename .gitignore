.DS_Store

# Python
__pycache__/
*.py[cod]

# Virtual environments (train.sh activates pytorch.venvsource/)
pytorch.venvsource/
.venv/
venv/

# Slurm job logs (keep the folder: sbatch fails to start a job whose log folder is missing)
logs/*
!logs/.gitkeep

# Training and testing outputs, written into each datasets/<name>/
model_weights/
y_pred_true*
runs/
